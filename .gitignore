# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# -----------------------------
# Dependencies / build
# -----------------------------
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next / build outputs
/.next/
/out/
/build/
/dist/

# Test output
/coverage/

# -----------------------------
# Local env / secrets (allow templates)
# -----------------------------
# Local dotenv files (ignore real secrets, keep templates)
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
.env.*
!.env.example
!.env.template

# Keys / certs
*.pem
*.key
*.crt
*.p12
*.jks
credentials.json

# Supabase local folder
.supabase/

# -----------------------------
# Editor / IDE
# -----------------------------
.vscode/
*.code-workspace
.idea/
*.sublime-workspace
*.sublime-project

# -----------------------------
# OS
# -----------------------------
.DS_Store
Thumbs.db

# -----------------------------
# Logs / debug
# -----------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# -----------------------------
# Caches / lock / runtime
# -----------------------------
.cache/
.parcel-cache/
.turbo/
/tmp/
/.serverless/

# keep lockfiles committed: package-lock.json, pnpm-lock.yaml, yarn.lock

# -----------------------------
# TypeScript
# -----------------------------
*.tsbuildinfo
next-env.d.ts

# -----------------------------
# Misc
# -----------------------------
.local
*.local

# Documentation / project exports (ignore large or local docs and bundles)
ordinum_gtd*
ordinum-gtd*
ordinum-brand*
ordinum_brand*
Documenta%C3%A7%C3%A3o*
Documentação*
documentacao*
*.ipynb
*.zip
*.tar.gz
*.tgz

